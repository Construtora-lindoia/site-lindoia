---
import Layout from '../layouts/Layout.astro';
import FormOrcamento from '../components/FormOrcamento.astro';
import { SITE } from '../lib/site';
---

<Layout
  title="Contato"
  description="Fale com a Construtora Lindóia em Sinop-MT: orçamentos de obras e pré-moldados pelo WhatsApp (66) 99986-7361 ou comercial@construtoralindoia.com.br."
>
  <div class="page-head">
    <div class="wrap">
      <div class="eyebrow">Contato</div>
      <h1>Fale com a Lindóia</h1>
      <p>Orçamento de obra, consulta de produtos ou qualquer outro assunto. O caminho mais rápido é o WhatsApp do comercial.</p>
    </div>
  </div>

  <section>
    <div class="wrap form-wrap">
      <div>
        <div class="eyebrow">Orçamento</div>
        <h2>Peça seu orçamento</h2>
        <p class="lead" style="margin-bottom:26px">Preenche que o nosso comercial te chama no WhatsApp.</p>
        <FormOrcamento />
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="cards">
        <div class="card destaque">
          <b>Comercial · novas obras</b>
          <p>{SITE.enderecoSede}</p>
          <p><a href={SITE.whatsappCTA} target="_blank" rel="noopener">{SITE.telefoneComercial} (WhatsApp)</a></p>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <a class="btn" href={SITE.whatsappCTA} target="_blank" rel="noopener">Chamar no WhatsApp</a>
        </div>
        <div class="card">
          <b>Unidade I</b>
          <p>{SITE.enderecoSede}</p>
          <p>{SITE.telefoneFixo}</p>
        </div>
        <div class="card">
          <b>Unidade II</b>
          <p>{SITE.enderecoUnidade2}</p>
          <p>{SITE.telefoneFixo}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mapa-sec">
    <div class="wrap">
      <div class="eyebrow">Onde estamos</div>
      <h2>Sede em Sinop-MT</h2>
      <p class="lead" style="margin-bottom:26px">Avenida Foz do Iguaçu, 444. Venha conhecer a fábrica.</p>
    </div>
    <div class="mapa">
      <iframe
        title="Mapa da Construtora Lindóia em Sinop-MT"
        src="https://maps.google.com/maps?q=Avenida%20Foz%20do%20Iguacu%2C%20444%2C%20Sinop%20-%20MT&t=&z=15&ie=UTF8&iwloc=&output=embed"
        width="100%"
        height="440"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </section>
</Layout>

<style>
  .cards { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 20px; }
  .card { border: 1px solid #e6e6e6; border-top: 4px solid var(--vermelho); padding: 34px; min-width: 0; overflow-wrap: anywhere; }
  .card b { text-transform: uppercase; display: block; margin-bottom: 14px; }
  .card p { color: #4a4a4a; margin-bottom: 8px; }
  .card a:hover { color: var(--vermelho); }
  .card .btn { margin-top: 16px; color: #fff; }
  .card .btn:hover { color: #fff; }
  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; } .card { padding: 26px; } }

  .mapa-sec { padding-bottom: 0; }
  .mapa { margin-top: 8px; }
  .mapa iframe { display: block; filter: grayscale(0.2); }
</style>
