---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
---

<Layout
  title="Contato"
  description="Fale com a Construtora Lindóia em Sinop-MT: orçamentos de obras e pré-moldados pelo WhatsApp (66) 99986-7361 ou comercial@construtoralindoia.com.br."
>
  <div class="page-head">
    <div class="wrap">
      <div class="eyebrow">Contato</div>
      <h1>Fale com a Lindóia</h1>
      <p>Orçamento de obra, consulta de produtos ou qualquer outro assunto — o caminho mais rápido é o WhatsApp do comercial.</p>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="cards">
        <div class="card destaque">
          <b>Comercial · novas obras</b>
          <p>{SITE.enderecoSede}</p>
          <p><a href={SITE.whatsapp} target="_blank" rel="noopener">{SITE.telefoneComercial} (WhatsApp)</a></p>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <a class="btn" href={SITE.whatsapp} target="_blank" rel="noopener">Chamar no WhatsApp</a>
        </div>
        <div class="card">
          <b>Unidade I</b>
          <p>{SITE.enderecoSede}</p>
          <p>{SITE.telefoneFixo}</p>
        </div>
        <div class="card">
          <b>Unidade II</b>
          <p>{SITE.enderecoUnidade2}</p>
          <p>{SITE.telefoneFixo}</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cards { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 20px; }
  .card { border: 1px solid #e6e6e6; border-top: 4px solid var(--vermelho); padding: 34px; }
  .card b { text-transform: uppercase; display: block; margin-bottom: 14px; }
  .card p { color: #4a4a4a; margin-bottom: 8px; }
  .card a:hover { color: var(--vermelho); }
  .card .btn { margin-top: 16px; color: #fff; }
  .card .btn:hover { color: #fff; }
  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; } }
</style>
