---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada">
  <section style="text-align:center; padding: 120px 24px;">
    <div class="eyebrow">Erro 404</div>
    <h2>Página não encontrada</h2>
    <p class="lead" style="margin: 0 auto 30px;">O endereço que você acessou não existe ou mudou de lugar.</p>
    <a class="btn" href="/">Voltar pra página inicial</a>
  </section>
</Layout>
