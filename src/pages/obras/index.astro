---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SEGMENTOS, SITE } from '../../lib/site';

const obras = (await getCollection('obras')).sort((a, b) => a.data.ordem - b.data.ordem);
const segmentosPresentes = [...new Set(obras.map((o) => o.data.segmento))];
---

<Layout
  title="Obras"
  description="Portfólio de obras da Construtora Lindóia: agroindústria, comercial e varejo, indústria e infraestrutura em Mato Grosso."
>
  <div class="page-head">
    <div class="wrap">
      <div class="eyebrow">Portfólio</div>
      <h1>Nossas obras</h1>
      <p>Três décadas de armazéns, silos, supermercados e plantas industriais construídos com estrutura pré-moldada de fabricação própria.</p>
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="filtros" id="filtros">
        <button class="on" data-f="todas">Todas</button>
        {segmentosPresentes.map((s) => (
          <button data-f={s}>{SEGMENTOS[s]}</button>
        ))}
      </div>
      <div class="obras-grid">
        {obras.map((obra) => (
          <a class="obra-card" data-seg={obra.data.segmento} href={`/obras/${obra.id}/`}>
            <img src={obra.data.capa} alt={`Obra ${obra.data.titulo}`} loading="lazy" />
            <figcaption>
              <span>{SEGMENTOS[obra.data.segmento]}</span>
              <b>{obra.data.titulo}{obra.data.cidade ? ` · ${obra.data.cidade}` : ''}</b>
            </figcaption>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Sua obra pode ser a próxima</h2>
      <p>Fale com o nosso comercial e receba o orçamento.</p>
      <a class="btn" href={SITE.whatsapp} target="_blank" rel="noopener">Chamar no WhatsApp</a>
    </div>
  </section>
</Layout>

<style>
  .obra-card.hide { display: none; }
</style>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('#filtros button');
  const cards = document.querySelectorAll<HTMLElement>('.obra-card');

  function aplicar(f: string) {
    botoes.forEach((b) => b.classList.toggle('on', b.dataset.f === f));
    cards.forEach((c) => c.classList.toggle('hide', f !== 'todas' && c.dataset.seg !== f));
  }

  botoes.forEach((btn) =>
    btn.addEventListener('click', () => aplicar(btn.dataset.f ?? 'todas'))
  );

  const seg = new URLSearchParams(location.search).get('seg');
  if (seg && [...botoes].some((b) => b.dataset.f === seg)) aplicar(seg);
</script>
