---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE, SEGMENTOS } from '../lib/site';
import clientesData from '../data/clientes.json';
import depoimentosData from '../data/depoimentos.json';

const clientes = clientesData.clientes;
const depoimentos = depoimentosData.depoimentos;

const obras = (await getCollection('obras'))
  .sort((a, b) => a.data.ordem - b.data.ordem);
const destaques = obras.filter((o) => o.data.destaque).slice(0, 6);
const obrasHome = destaques.length >= 3 ? destaques : obras.slice(0, 6);

const produtos = (await getCollection('produtos'))
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .slice(0, 6);
---

<Layout>
  <section class="hero" id="topo">
    <video autoplay muted loop playsinline preload="auto" poster="/img/obras/machadao-primavera-1.webp">
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="wrap">
      <div class="hero-inner">
        <span class="hero-kicker"><b>29 anos</b> · desde 1997</span>
        <h1>A marca da solidez em sua obra</h1>
        <p>
          Estruturas pré-moldadas de fabricação própria, do projeto à entrega. Duas unidades
          fabris em Sinop-MT construindo armazéns, silos, pavilhões e obras comerciais em todo
          o Brasil.
        </p>
        <div class="acts">
          <a class="btn" href={SITE.whatsappCTA} target="_blank" rel="noopener">Fale com o comercial</a>
          <a class="btn ghost" href="/obras/">Conheça nossas obras</a>
        </div>
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="wrap stats-grid">
      <div class="stat"><b><i class="cnt" data-v="29">29</i><span> anos</span></b><small>de experiência de mercado</small></div>
      <div class="stat"><b><i class="cnt" data-v="1" data-pre="+">+1</i><span> milhão</span></b><small>de m² construídos</small></div>
      <div class="stat brasil">
        <b>
          <svg class="mapa-br" viewBox="0 0 1024 1024" role="img" aria-label="Mapa do Brasil">
            <g transform="translate(0,1024) scale(0.1,-0.1)">
              <path d="M3255 9936 c-38 -13 -112 -44 -162 -69 -70 -36 -104 -47 -138 -47 -29 0 -60 -8 -84 -22 -32 -18 -40 -30 -47 -65 l-9 -44 -57 36 c-53 34 -64 37 -140 38 -46 1 -91 -2 -100 -6 -13 -7 -20 -1 -33 22 l-16 31 -91 0 -91 0 84 -60 84 -60 -4 -80 c-3 -75 -1 -84 24 -120 23 -32 26 -45 20 -78 -7 -44 -11 -42 110 -57 28 -4 56 -8 63 -10 19 -7 -70 -83 -114 -99 -29 -10 -40 -20 -44 -40 -3 -14 -18 -42 -34 -62 l-28 -36 -25 24 -25 23 -30 -37 c-16 -21 -56 -52 -88 -69 -40 -21 -69 -47 -96 -84 -41 -56 -54 -60 -54 -19 0 31 -4 30 -85 -6 -76 -34 -63 -38 -159 47 -52 47 -65 53 -103 53 l-43 0 0 56 c0 51 -4 61 -46 115 -51 67 -47 67 -137 1 l-49 -35 -36 19 c-20 10 -40 20 -44 22 -5 2 -8 -5 -8 -16 0 -28 -77 -36 -247 -27 l-133 7 -20 -46 c-10 -25 -22 -69 -26 -96 l-7 -50 44 -1 c24 0 64 -8 89 -17 38 -15 46 -23 53 -55 5 -21 7 -41 4 -44 -3 -3 -21 4 -39 15 l-33 20 -72 -33 -73 -34 0 -96 0 -96 59 -54 c52 -49 62 -65 91 -146 l33 -91 -22 -62 c-18 -49 -24 -99 -33 -251 l-10 -190 -48 -125 c-32 -84 -53 -124 -62 -122 -7 2 -37 6 -67 9 -42 5 -57 3 -65 -9 -16 -22 -111 -68 -140 -68 -75 0 -254 -58 -296 -96 -14 -12 -57 -43 -97 -68 -77 -49 -87 -70 -82 -156 2 -24 -6 -48 -25 -77 l-28 -42 17 -58 17 -58 -24 -14 c-12 -8 -44 -37 -70 -63 -37 -36 -48 -55 -48 -79 0 -22 5 -32 20 -36 27 -7 25 -16 -8 -31 -67 -29 -99 -97 -50 -104 17 -2 24 -12 28 -38 7 -43 139 -243 188 -286 l36 -31 -27 -46 c-15 -25 -27 -48 -27 -51 0 -3 31 -6 69 -6 38 0 92 -5 120 -12 46 -10 51 -14 51 -38 0 -15 7 -34 16 -41 9 -7 20 -23 24 -35 9 -23 51 -34 135 -34 47 1 56 5 155 80 57 44 110 80 116 80 6 0 17 -7 24 -15 10 -12 8 -25 -10 -69 -21 -50 -22 -59 -11 -130 6 -42 11 -97 11 -121 0 -39 4 -46 30 -60 40 -21 60 -19 102 10 35 24 44 25 175 25 76 0 152 -4 168 -8 48 -14 110 7 140 47 14 21 43 42 68 51 23 9 71 37 106 63 35 26 74 47 87 47 14 0 30 10 41 26 23 36 83 72 166 100 55 19 92 24 168 24 113 0 117 -4 93 -93 -19 -70 -18 -137 2 -166 12 -17 15 -35 10 -68 -3 -25 -2 -62 4 -82 5 -20 12 -48 15 -63 4 -21 15 -30 54 -43 33 -11 58 -28 76 -51 17 -22 34 -34 50 -34 20 0 25 -7 31 -35 6 -31 9 -35 51 -41 25 -4 76 -4 114 -1 53 4 70 2 80 -9 23 -28 68 -45 88 -35 14 8 24 4 46 -19 16 -17 36 -30 45 -30 9 0 31 -11 50 -25 25 -18 46 -25 82 -25 43 0 48 -3 54 -25 3 -14 20 -36 38 -49 27 -20 47 -24 146 -30 146 -8 162 -11 205 -50 29 -25 36 -41 43 -86 6 -40 20 -73 50 -117 28 -42 42 -73 42 -95 0 -33 0 -33 -45 -30 -41 4 -45 2 -51 -23 -5 -20 0 -34 23 -63 22 -27 31 -52 35 -92 4 -30 14 -74 23 -97 l17 -43 157 -1 c86 -1 183 0 217 1 72 2 83 -10 59 -67 -9 -20 -15 -66 -15 -107 l0 -71 73 -47 c39 -26 84 -52 100 -59 38 -17 50 -69 49 -206 l0 -113 -40 -47 c-38 -46 -82 -158 -82 -210 0 -35 41 -178 61 -209 24 -39 25 -105 2 -189 -14 -54 -15 -68 -4 -88 10 -18 10 -30 2 -45 -19 -35 -13 -40 58 -52 59 -11 75 -11 116 4 45 15 50 15 66 0 17 -15 20 -15 45 5 27 22 44 20 44 -5 0 -10 14 -14 56 -14 48 0 62 -5 95 -31 22 -17 44 -41 51 -52 21 -39 48 -161 54 -245 7 -78 9 -84 36 -98 25 -13 36 -13 108 4 l81 19 18 -23 c50 -64 48 -164 -8 -311 -30 -80 -30 -83 -11 -93 10 -5 32 -10 48 -10 16 0 50 -9 74 -20 65 -29 78 -68 77 -235 0 -129 0 -130 -27 -151 -15 -11 -54 -31 -87 -44 -36 -14 -85 -46 -124 -79 -34 -31 -88 -77 -120 -102 -118 -97 -228 -213 -241 -254 -7 -22 -35 -66 -61 -98 -27 -32 -56 -72 -66 -88 -10 -16 -26 -32 -38 -35 -11 -4 -36 -19 -56 -35 -30 -23 -35 -33 -31 -58 3 -24 10 -31 35 -37 26 -5 34 -2 54 22 29 37 78 35 108 -4 11 -15 48 -55 82 -90 35 -34 63 -71 63 -81 0 -10 8 -25 19 -35 16 -15 19 -15 31 -1 7 9 22 21 33 27 18 9 28 2 82 -56 51 -55 67 -66 94 -66 27 0 44 -12 107 -78 41 -42 77 -80 81 -84 5 -4 50 -48 102 -98 82 -79 169 -140 200 -140 5 0 20 17 32 38 12 20 64 80 114 132 51 52 107 118 125 145 19 28 65 88 104 135 114 136 127 156 143 216 19 74 80 159 184 259 88 84 209 228 209 248 0 7 16 45 35 85 33 69 34 75 20 102 -8 16 -15 46 -15 66 0 21 -7 60 -16 88 -16 51 -15 52 21 171 54 178 82 224 174 289 42 30 110 87 151 128 96 94 154 131 256 165 l82 26 62 -26 c34 -15 66 -27 71 -27 5 0 18 14 28 31 15 24 17 38 10 57 -5 14 -8 27 -5 29 2 3 36 15 75 27 70 22 71 23 51 41 -27 25 -17 35 37 35 32 0 50 -5 59 -17 12 -17 17 -14 63 32 l51 49 0 -36 0 -36 163 -6 c89 -4 191 -8 227 -9 l65 -2 10 61 c13 78 36 105 115 133 87 31 130 78 130 142 0 38 5 50 34 78 22 21 36 46 40 71 5 32 17 47 85 101 71 58 81 69 96 121 14 45 24 60 51 74 28 15 40 34 73 114 28 66 41 115 44 160 8 116 35 189 88 241 l47 46 16 134 c9 81 28 176 47 239 29 95 33 122 39 290 6 157 12 206 39 325 18 77 43 165 55 195 l22 55 56 5 57 5 63 85 c66 87 146 216 191 306 15 29 48 70 80 97 31 26 72 69 91 96 31 41 45 51 87 62 44 12 58 23 127 101 204 234 233 273 294 393 117 230 134 303 93 404 -14 36 -25 84 -25 107 0 77 -22 198 -42 233 -10 19 -22 63 -25 99 -6 63 -8 67 -65 124 l-58 58 -107 0 c-241 1 -429 93 -560 277 -38 54 -57 70 -117 99 -46 24 -95 60 -141 105 -65 63 -77 71 -173 104 -102 35 -109 36 -320 45 -130 5 -241 15 -277 24 -33 8 -84 15 -113 16 -40 0 -70 9 -124 36 -39 20 -101 42 -138 50 -38 7 -74 16 -82 19 -8 3 -23 -7 -36 -25 -19 -25 -29 -30 -66 -30 -40 0 -47 -4 -81 -46 l-38 -46 -13 23 c-12 22 -9 27 27 64 21 23 39 48 39 56 0 8 -20 30 -44 48 -37 28 -46 41 -53 80 -7 39 -14 49 -43 63 -23 12 -48 16 -72 13 -32 -4 -47 1 -102 39 -35 24 -81 49 -103 56 -21 7 -92 37 -158 68 l-120 56 -133 4 -133 4 -30 -28 c-17 -16 -51 -60 -77 -98 -50 -73 -98 -106 -152 -106 l-30 0 75 104 c93 127 103 157 72 203 -26 39 -59 52 -147 60 -76 6 -167 53 -172 87 -3 18 -11 21 -60 24 -53 3 -57 5 -72 36 -22 47 -20 66 7 66 42 0 48 11 37 71 -7 38 -7 72 0 109 10 54 10 56 -17 77 -16 13 -42 23 -59 23 -29 0 -32 3 -37 38 -4 21 -13 46 -21 57 -13 18 -15 18 -41 1 -15 -10 -29 -16 -31 -13 -3 2 -9 32 -15 66 -6 37 -22 81 -39 110 -23 37 -30 60 -30 102 -1 143 -58 259 -127 259 -27 0 -45 -10 -85 -47 -63 -60 -171 -267 -183 -351 -6 -44 -14 -59 -47 -90 l-39 -37 -111 9 c-79 7 -126 6 -167 -2 -32 -7 -83 -12 -115 -12 -51 0 -64 4 -107 35 l-48 36 -67 -12 c-37 -6 -94 -9 -127 -5 -48 5 -64 3 -79 -11 -22 -20 -23 -64 -2 -105 23 -44 8 -50 -122 -45 -90 2 -117 7 -146 24 l-36 21 -58 -48 c-48 -39 -87 -58 -199 -99 -167 -61 -199 -63 -269 -18 -28 19 -65 42 -83 52 -35 20 -43 39 -43 105 0 25 -7 70 -15 100 -8 30 -14 78 -13 106 1 39 -4 59 -20 82 l-22 30 50 42 c48 41 50 43 50 95 0 50 -2 55 -39 84 -30 24 -49 31 -81 31 -33 0 -50 7 -77 30 -42 37 -95 39 -198 6z" />
            </g>
          </svg>
        </b>
        <small>Obras em todo o Brasil</small>
      </div>
      <div class="stat"><b><i class="cnt" data-v="27" data-pre="+">+27</i><span> milhões</span></b><small>de sacas em armazenagem de grãos</small></div>
      <div class="stat"><b><i class="cnt" data-v="29" data-pre="+">+29</i></b><small>supermercados construídos</small></div>
    </div>
  </section>

  <section id="solucoes">
    <div class="wrap">
      <div class="eyebrow"><i>01</i>Soluções</div>
      <h2>Do projeto à entrega, com fabricação própria</h2>
      <p class="lead">
        Integração vertical completa: projetamos, fabricamos, transportamos com frota própria
        e montamos. Controle total sobre prazo e qualidade.
      </p>
      <div class="sol-grid">
        <a class="sol" href="/solucoes/agroindustria/">
          <img src="/img/obras/fazenda-fenix-1.webp" alt="" loading="lazy" />
          <div><h3>Agroindústria</h3><p>Armazéns, silos e estruturas para o agronegócio</p></div>
        </a>
        <a class="sol" href="/solucoes/comercial/">
          <img src="/img/obras/machadao-primavera-1.webp" alt="" loading="lazy" />
          <div><h3>Comercial e Varejo</h3><p>Supermercados, lojas e centros comerciais</p></div>
        </a>
        <a class="sol" href="/solucoes/industria/">
          <img src="/img/obras/bertuol.webp" alt="" loading="lazy" />
          <div><h3>Indústria e Infraestrutura</h3><p>Plantas industriais e obras de grande porte</p></div>
        </a>
        <a class="sol" href="/solucoes/turnkey/">
          <img src="/img/obras/armazem.webp" alt="" loading="lazy" />
          <div><h3>Turnkey</h3><p>Sua obra pronta, entregue de ponta a ponta</p></div>
        </a>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="eyebrow"><i>02</i>Portfólio</div>
      <h2>Nossas obras</h2>
      <div class="obras-grid">
        {obrasHome.map((obra) => (
          <a class="obra-card" href={`/obras/${obra.id}/`}>
            <img src={obra.data.capa} alt={`Obra ${obra.data.titulo}`} loading="lazy" />
            <figcaption>
              <span>{SEGMENTOS[obra.data.segmento]}</span>
              <b>{obra.data.titulo}{obra.data.cidade ? ` · ${obra.data.cidade}` : ''}</b>
            </figcaption>
          </a>
        ))}
      </div>
      <p style="margin-top:30px"><a class="btn" href="/obras/">Ver todas as obras</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow"><i>03</i>Fabricação própria</div>
      <h2>Conte com a qualidade dos nossos produtos</h2>
      <p class="lead">Pré-moldados de concreto produzidos nas nossas duas unidades fabris.</p>
      <div class="prod-grid">
        {produtos.map((p) => (
          <a class="prod" href={`/produtos/${p.id}/`}>
            <img src={p.data.imagem} alt={p.data.nome} loading="lazy" />
            <b>{p.data.nome}</b>
          </a>
        ))}
      </div>
      <p style="margin-top:30px"><a class="btn" href="/produtos/">Catálogo completo</a></p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="eyebrow"><i>04</i>Quem confia</div>
      <h2>Nossos clientes</h2>
      <div class="marquee">
        <div class="marquee-track">
          {[...clientes, ...clientes].map((c, i) => (
            <div class={'cli' + (i >= clientes.length ? ' dup' : '')}>
              <img src={c.logo} alt={c.nome} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
      <div class="dep-grid">
        {depoimentos.map((d) => (
          <div class="dep">
            <p>"{d.texto}"</p>
            <footer><b>{d.autor}</b><span>{d.empresa}</span></footer>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="sobre-resumo" class="escura">
    <div class="wrap sobre-grid">
      <img
        src="/img/institucional/historia-fundadores.webp"
        alt="Fundadores da Construtora Lindóia no canteiro de obras, década de 1990"
        loading="lazy"
      />
      <div>
        <div class="eyebrow"><i>05</i>29 anos de história</div>
        <h2>29 anos entregando qualidade, compromisso e confiança</h2>
        <p class="lead">
          Fundada em 1997 pelos irmãos Luis Carlos e Airto César Cavaglieri, a Lindóia cresceu
          junto com o Mato Grosso: do primeiro canteiro em Sinop às duas unidades fabris que
          hoje somam 50.000 m².
        </p>
        <ul>
          <li>Fabricação própria com controle total do processo</li>
          <li>Frota própria: fabricamos, transportamos e montamos</li>
          <li>Corpo técnico especializado e segurança em canteiro</li>
          <li>Energia solar nas operações</li>
        </ul>
        <p style="margin-top:26px"><a class="btn" href="/sobre/">Nossa história</a></p>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Vamos construir juntos?</h2>
      <p>Fale direto com o nosso comercial e receba o orçamento da sua obra.</p>
      <a class="btn" href={SITE.whatsappCTA} target="_blank" rel="noopener">
        Chamar no WhatsApp: {SITE.telefoneComercial}
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 640px;
    display: flex;
    align-items: center;
    color: #fff;
    padding: 0;
    overflow: hidden;
    background: url('/img/obras/machadao-primavera-1.webp') center/cover no-repeat;
  }
  .hero video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(100deg, rgba(25,25,25,0.82) 0%, rgba(25,25,25,0.55) 45%, rgba(219,77,75,0.28) 100%);
  }
  /* grid técnico de blueprint sobre o vídeo */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.07;
    background-image:
      linear-gradient(#fff 1px, transparent 1px),
      linear-gradient(90deg, #fff 1px, transparent 1px);
    background-size: 90px 90px;
  }
  .hero .wrap { position: relative; z-index: 2; width: 100%; padding-top: 90px; padding-bottom: 90px; }
  .hero-inner { max-width: 600px; }

  /* entrada cinematográfica do hero */
  @keyframes sobe {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: none; }
  }
  .hero .hero-kicker { animation: sobe 0.6s 0.1s both; }
  .hero h1 { animation: sobe 0.6s 0.25s both; }
  .hero p { animation: sobe 0.6s 0.4s both; }
  .hero .acts { animation: sobe 0.6s 0.55s both; }
  .hero-kicker {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #e8e8e8;
    margin-bottom: 16px;
  }
  .hero-kicker b { color: #f0c36a; }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.12;
    max-width: 760px;
  }
  .hero p { margin: 22px 0 34px; font-size: 1.05rem; max-width: 560px; color: #eee; }
  .hero .acts { display: flex; gap: 16px; flex-wrap: wrap; }

  .stats { background: var(--grafite); color: #fff; padding: 0; }
  .stats-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; padding-top: 44px; padding-bottom: 44px; }
  .stat { text-align: center; border-left: 1px solid rgba(255,255,255,0.12); }
  .stat:first-child { border-left: none; }
  .stat b { display: block; font-size: 1.7rem; font-weight: 800; }
  .stat b i { font-style: normal; font-variant-numeric: tabular-nums; }
  .stat b span { color: var(--vermelho); }
  .stat small { color: #bdbdbd; text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.1em; }
  .stat.brasil b { display: flex; align-items: center; justify-content: center; margin-top: 0.5rem; }
  .mapa-br { display: block; height: 2.4rem; width: auto; }
  .mapa-br path { fill: none; stroke: var(--vermelho); stroke-width: 300; stroke-linejoin: round; stroke-linecap: round; }
  @media (max-width: 800px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); row-gap: 32px; }
    .stat { border-left: none; }
    .stat b { font-size: 1.55rem; }
    /* mapa vai pro fim da faixa (bloco 2x2 de números primeiro) e ganha tamanho */
    .stats-grid .stat.brasil { grid-column: 1 / -1; order: 1; margin-top: 6px; }
    .stats-grid .stat.brasil .mapa-br { height: 3.4rem; }
  }
  @media (max-width: 600px) {
    .hero { min-height: 540px; }
    .hero .wrap { padding-top: 56px; padding-bottom: 64px; }
    .hero .acts .btn { width: 100%; text-align: center; }
    /* no celular a home mostra só 4 obras; o resto fica em "Ver todas as obras" */
    .obras-grid .obra-card:nth-child(n + 5) { display: none; }
  }

  .sol-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 44px; }
  .sol { position: relative; height: 340px; overflow: hidden; background: var(--grafite); }
  .sol img { height: 100%; width: 100%; object-fit: cover; opacity: 0.75; transition: transform 0.3s, opacity 0.3s; }
  .sol:hover img { transform: scale(1.05); opacity: 0.5; }
  .sol div {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 22px;
    color: #fff;
    background: linear-gradient(transparent, rgba(0,0,0,0.75));
  }
  .sol div::before { content: ''; display: block; width: 34px; height: 3px; background: var(--vermelho); margin-bottom: 10px; }
  .sol h3 { font-size: 1.05rem; text-transform: uppercase; font-weight: 700; }
  .sol p { font-size: 0.8rem; color: #ddd; margin-top: 4px; }
  @media (max-width: 900px) { .sol-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .sol-grid { grid-template-columns: 1fr; } }

  .marquee {
    overflow: hidden;
    margin-top: 44px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: desfile 90s linear infinite;
    will-change: transform;
  }
  @keyframes desfile { to { transform: translateX(-50%); } }
  .cli {
    background: #fff;
    border: 1px solid #e6e6e6;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 20px;
    height: 118px;
    flex: 0 0 auto;
    width: 204px;
    margin-right: 18px;
  }
  .cli img { max-height: 72px; max-width: 164px; width: auto; filter: grayscale(1); opacity: 0.75; transition: filter 0.2s, opacity 0.2s; }
  .cli:hover img { filter: none; opacity: 1; }

  .dep-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 44px; }
  .dep { background: #fff; border: 1px solid #e6e6e6; border-top: 4px solid var(--vermelho); padding: 34px; position: relative; overflow: hidden; }
  .dep::before {
    content: '\201C';
    position: absolute;
    top: -14px;
    right: 16px;
    font-family: Georgia, serif;
    font-size: 7rem;
    line-height: 1;
    color: rgba(219, 77, 75, 0.1);
    pointer-events: none;
  }
  .dep p { font-size: 1rem; color: #4a4a4a; font-style: italic; position: relative; }
  .dep footer { margin-top: 20px; }
  .dep footer b { display: block; text-transform: uppercase; font-size: 0.85rem; }
  .dep footer span { font-size: 0.78rem; color: var(--cinza); }
  @media (max-width: 800px) { .dep-grid { grid-template-columns: 1fr; } }

  .sobre-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 60px; align-items: center; }
  .sobre-grid ul { list-style: none; margin-top: 20px; }
  .sobre-grid li { padding-left: 26px; position: relative; margin-bottom: 10px; color: #5c5c5c; font-size: 0.95rem; }
  .sobre-grid li::before { content: ''; position: absolute; left: 0; top: 9px; width: 12px; height: 3px; background: var(--vermelho); }
  @media (max-width: 900px) { .sobre-grid { grid-template-columns: 1fr; } }

  /* seção escura: 29 anos de história */
  .escura { background: #2b2b2b; color: #fff; }
  .escura .eyebrow i { color: #6e6e6e; }
  .escura .lead { color: #c9c9c9; }
  .escura .sobre-grid li { color: #d3d3d3; }
  .escura img {
    background: #fff;
    padding: 18px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }
</style>

<script>
  // números que contam quando entram na tela
  const fmt = new Intl.NumberFormat('pt-BR');
  const contadores = document.querySelectorAll<HTMLElement>('.cnt');
  if (contadores.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          const el = e.target as HTMLElement;
          const alvo = Number(el.dataset.v || 0);
          const pre = el.dataset.pre || '';
          const t0 = performance.now();
          const dur = 1400;
          const passo = (t: number) => {
            const p = Math.min(1, (t - t0) / dur);
            const suave = 1 - Math.pow(1 - p, 3);
            el.textContent = pre + fmt.format(Math.round(alvo * suave));
            if (p < 1) requestAnimationFrame(passo);
          };
          requestAnimationFrame(passo);
        });
      },
      { threshold: 0.6 }
    );
    contadores.forEach((el) => io.observe(el));
  }

  // hero video: garante o autoplay mudo/inline no mobile (alguns navegadores bloqueiam sem um empurrão)
  const heroVid = document.querySelector('.hero video') as HTMLVideoElement | null;
  if (heroVid) {
    const tentaTocar = () => {
      heroVid.muted = true;
      const pr = heroVid.play();
      if (pr && typeof pr.catch === 'function') pr.catch(() => {});
    };
    tentaTocar();
    heroVid.addEventListener('canplay', tentaTocar, { once: true });
    document.addEventListener('visibilitychange', () => { if (!document.hidden) tentaTocar(); });
    // fallback: se o navegador insistir no bloqueio, toca no primeiro gesto do usuário
    const noGesto = () => {
      tentaTocar();
      ['touchstart', 'click', 'scroll'].forEach((ev) => window.removeEventListener(ev, noGesto));
    };
    ['touchstart', 'click', 'scroll'].forEach((ev) =>
      window.addEventListener(ev, noGesto, { once: true, passive: true })
    );
  }
</script>
