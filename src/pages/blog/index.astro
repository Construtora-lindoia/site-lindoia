---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.rascunho)
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime());

const fmtData = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Blog"
  description="Notícias, obras entregues e conteúdo sobre construção industrial e pré-moldados de concreto, direto da Construtora Lindóia em Sinop-MT."
>
  <div class="page-head">
    <div class="wrap">
      <div class="eyebrow">Blog</div>
      <h1>Notícias e conteúdo</h1>
      <p>Obras entregues, novidades da Lindóia e informação útil pra quem vai construir.</p>
    </div>
  </div>

  <section>
    <div class="wrap">
      {posts.length === 0 && <p class="lead">Em breve, os primeiros conteúdos.</p>}
      <div class="posts-grid">
        {posts.map((post) => (
          <a class="post-card" href={`/blog/${post.id}/`}>
            <div class="post-thumb">
              {post.data.capa && <img src={post.data.capa} alt="" loading="lazy" />}
            </div>
            <div class="post-info">
              <small>{fmtData(post.data.data)}</small>
              <b>{post.data.titulo}</b>
              <p>{post.data.descricao}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .posts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 900px) { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .posts-grid { grid-template-columns: 1fr; } }
  .post-card { background: #fff; border: 1px solid #e6e6e6; display: block; transition: box-shadow 0.15s, transform 0.15s; }
  .post-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08); }
  .post-thumb { aspect-ratio: 16 / 9; background: var(--cinza-claro); overflow: hidden; }
  .post-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .post-info { padding: 20px; }
  .post-info small {
    color: var(--vermelho);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .post-info b { display: block; font-size: 1.05rem; line-height: 1.35; margin: 8px 0; }
  .post-info p { color: #6b7280; font-size: 0.85rem; }
</style>
