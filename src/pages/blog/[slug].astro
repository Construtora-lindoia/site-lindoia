---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.rascunho);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmtData = post.data.data.toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={post.data.titulo} description={post.data.descricao}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.data.titulo,
      description: post.data.descricao,
      datePublished: post.data.data.toISOString(),
      author: { '@type': 'Organization', name: SITE.nome },
      publisher: { '@type': 'Organization', name: SITE.nome },
    })}
  />
  <div class="page-head">
    <div class="wrap">
      <div class="eyebrow">{fmtData}</div>
      <h1>{post.data.titulo}</h1>
      <p>{post.data.descricao}</p>
    </div>
  </div>

  <article class="post">
    <div class="wrap">
      {post.data.capa && <img class="post-capa" src={post.data.capa} alt={post.data.titulo} />}
      <div class="prosa">
        <Content />
      </div>
      <p style="margin-top:44px"><a class="btn sec-btn" href="/blog/">← Todos os posts</a></p>
    </div>
  </article>

  <section class="cta">
    <div class="wrap">
      <h2>Vamos construir juntos?</h2>
      <p>Fale com o nosso comercial e receba o orçamento da sua obra.</p>
      <a class="btn" href={SITE.whatsapp} target="_blank" rel="noopener">Chamar no WhatsApp</a>
    </div>
  </section>
</Layout>

<style>
  .post { padding: 60px 0; }
  .post .wrap { max-width: 820px; }
  .post-capa { width: 100%; margin-bottom: 40px; }
  .prosa { font-size: 1.05rem; color: #3d3d3d; }
  .prosa :global(h2) {
    font-size: 1.4rem;
    text-transform: none;
    margin: 36px 0 12px;
  }
  .prosa :global(h3) { font-size: 1.15rem; margin: 28px 0 10px; }
  .prosa :global(p) { margin-bottom: 16px; }
  .prosa :global(ul), .prosa :global(ol) { margin: 0 0 16px 22px; }
  .prosa :global(li) { margin-bottom: 6px; }
  .prosa :global(img) { margin: 24px 0; }
  .prosa :global(strong) { color: var(--grafite); }
  .prosa :global(blockquote) {
    border-left: 4px solid var(--vermelho);
    padding-left: 18px;
    color: #5c5c5c;
    font-style: italic;
    margin: 24px 0;
  }
  .sec-btn { background: var(--grafite); }
</style>
