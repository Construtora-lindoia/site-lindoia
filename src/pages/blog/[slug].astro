---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.rascunho);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmtData = post.data.data.toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const relObras = post.data.obras.length
  ? (await getCollection('obras'))
      .filter((o) => post.data.obras.includes(o.id))
      .sort((a, b) => post.data.obras.indexOf(a.id) - post.data.obras.indexOf(b.id))
  : [];
const relProdutos = post.data.produtos.length
  ? (await getCollection('produtos'))
      .filter((p) => post.data.produtos.includes(p.id))
      .sort((a, b) => post.data.produtos.indexOf(a.id) - post.data.produtos.indexOf(b.id))
  : [];
---

<Layout title={post.data.titulo} description={post.data.descricao}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.data.titulo,
      description: post.data.descricao,
      datePublished: post.data.data.toISOString(),
      author: { '@type': 'Organization', name: SITE.nome },
      publisher: { '@type': 'Organization', name: SITE.nome },
    })}
  />
  <div class="page-head">
    <div class="wrap">
      <div class="eyebrow">{fmtData}</div>
      <h1>{post.data.titulo}</h1>
      <p>{post.data.descricao}</p>
    </div>
  </div>

  <article class="post">
    <div class="wrap">
      {post.data.capa && <img class="post-capa" src={post.data.capa} alt={post.data.titulo} />}
      <div class="prosa">
        <Content />
      </div>
      <p style="margin-top:44px"><a class="btn sec-btn" href="/blog/">← Todos os posts</a></p>
    </div>
  </article>

  {(relObras.length > 0 || relProdutos.length > 0) && (
    <section class="rel">
      <div class="wrap">
        <h2>Veja também</h2>
        <div class="rel-grid">
          {relObras.map((o) => (
            <a class="rel-card" href={`/obras/${o.id}/`}>
              <img src={o.data.capa} alt={`Obra ${o.data.titulo}`} loading="lazy" />
              <div class="rel-meta"><span>Obra</span><b>{o.data.titulo}</b></div>
            </a>
          ))}
          {relProdutos.map((p) => (
            <a class="rel-card rel-prod" href={`/produtos/${p.id}/`}>
              <img src={p.data.imagem} alt={p.data.nome} loading="lazy" />
              <div class="rel-meta"><span>Produto</span><b>{p.data.nome}</b></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="cta">
    <div class="wrap">
      <h2>Vamos construir juntos?</h2>
      <p>Fale com o nosso comercial e receba o orçamento da sua obra.</p>
      <a class="btn" href={SITE.whatsappCTA} target="_blank" rel="noopener">Chamar no WhatsApp</a>
    </div>
  </section>
</Layout>

<style>
  .post { padding: 60px 0; }
  .post .wrap { max-width: 820px; }
  .post-capa { width: 100%; margin-bottom: 40px; }
  .prosa { font-size: 1.05rem; color: #3d3d3d; }
  .prosa :global(h2) {
    font-size: 1.4rem;
    text-transform: none;
    margin: 36px 0 12px;
  }
  .prosa :global(h3) { font-size: 1.15rem; margin: 28px 0 10px; }
  .prosa :global(p) { margin-bottom: 16px; }
  .prosa :global(ul), .prosa :global(ol) { margin: 0 0 16px 22px; }
  .prosa :global(li) { margin-bottom: 6px; }
  .prosa :global(img) { margin: 24px 0; }
  .prosa :global(strong) { color: var(--grafite); }
  .prosa :global(blockquote) {
    border-left: 4px solid var(--vermelho);
    padding-left: 18px;
    color: #5c5c5c;
    font-style: italic;
    margin: 24px 0;
  }
  .sec-btn { background: var(--grafite); }

  .prosa :global(a) { color: var(--vermelho); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

  .rel { background: #f6f6f6; padding: 60px 0; }
  .rel h2 { font-size: 1.4rem; margin-bottom: 24px; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .rel-card { display: block; background: #fff; border: 1px solid #e6e6e6; color: inherit; text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s; }
  .rel-card:hover { border-color: var(--vermelho); box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06); }
  .rel-card img { width: 100%; height: 160px; object-fit: cover; display: block; }
  .rel-prod img { object-fit: contain; background: #f5f5f5; padding: 14px; }
  .rel-meta { padding: 16px; }
  .rel-meta span { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--vermelho); font-weight: 700; }
  .rel-meta b { display: block; margin-top: 4px; font-size: 0.95rem; color: var(--grafite); }
  @media (max-width: 800px) { .rel-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .rel-grid { grid-template-columns: 1fr; } }
</style>
