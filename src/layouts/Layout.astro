---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.descricao } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.nome}` : `${SITE.nome} | ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Origem pública atual (preview na Vercel). Trocar para o domínio final na virada.
const OG_ORIGEM = 'https://construtora-lindoia.vercel.app';
const ogUrl = new URL(Astro.url.pathname, OG_ORIGEM);
const ogImage = new URL('/img/og-card-v2.jpg', OG_ORIGEM);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/img/favicon.webp" type="image/webp" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#373737" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'GeneralContractor',
        name: SITE.nome,
        url: 'https://construtoralindoia.com.br',
        telephone: '+55 66 99986-7361',
        email: SITE.email,
        foundingDate: '1997',
        slogan: SITE.tagline,
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Avenida Foz do Iguaçu, 444',
          addressLocality: 'Sinop',
          addressRegion: 'MT',
          addressCountry: 'BR',
        },
        areaServed: 'Mato Grosso',
      })}
    />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <a
      class="zap-flutuante"
      href={SITE.whatsappCTA}
      target="_blank"
      rel="noopener"
      aria-label="Falar com a Lindóia no WhatsApp"
    >
      <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
      </svg>
    </a>
    <script is:inline>
      // sensor de visitas (sem cookie, sem dado pessoal) — alimenta a aba Visitas do painel
      (function () {
        try {
          if (navigator.webdriver) return; // ignora bots e capturas automáticas
          var path = location.pathname;
          if (path.indexOf('/admin') === 0) return;
          var sid = sessionStorage.getItem('lin_sid');
          if (!sid) { sid = Math.random().toString(36).slice(2) + Date.now().toString(36); sessionStorage.setItem('lin_sid', sid); }
          var origem = 'Direto';
          var utm = new URLSearchParams(location.search).get('utm_source');
          var ref = document.referrer;
          if (utm) origem = utm;
          else if (ref) {
            try {
              var h = new URL(ref).hostname.replace(/^www\./, '');
              if (h === location.hostname) origem = 'Direto';
              else if (/google\./.test(h)) origem = 'Google';
              else if (/bing\./.test(h)) origem = 'Bing';
              else if (/instagram\./.test(h)) origem = 'Instagram';
              else if (/facebook\.|(^|\.)fb\./.test(h)) origem = 'Facebook';
              else if (/whatsapp|wa\.me/.test(h)) origem = 'WhatsApp';
              else origem = h;
            } catch (e) {}
          }
          var dispositivo = Math.min(screen.width || 9999, window.innerWidth || 9999) < 768 ? 'mobile' : 'desktop';
          var corpo = JSON.stringify({ caminho: path, origem: origem, dispositivo: dispositivo, sessao: sid });
          if (navigator.sendBeacon) navigator.sendBeacon('/api/pageviews', new Blob([corpo], { type: 'application/json' }));
          else fetch('/api/pageviews', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: corpo, keepalive: true });
        } catch (e) {}
      })();

      (function () {
        // header encolhe e ganha vidro ao rolar
        var hd = document.querySelector('.site-header');
        var aoRolar = function () {
          if (hd) hd.classList.toggle('rolou', window.scrollY > 40);
        };
        aoRolar();
        window.addEventListener('scroll', aoRolar, { passive: true });

        // animações de entrada no scroll
        var alvos = document.querySelectorAll(
          'section h2, section .lead, .obra-card, .prod, .sol, .dep, .post-card, .stat, .card, .passo'
        );
        if (!('IntersectionObserver' in window) || !alvos.length) return;
        var io = new IntersectionObserver(
          function (entradas) {
            entradas.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('on');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -4% 0px' }
        );
        alvos.forEach(function (el) {
          el.classList.add('rv');
          var irmaos = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
          el.style.transitionDelay = Math.min(irmaos * 70, 350) + 'ms';
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>

<style>
  .zap-flutuante {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 30;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .zap-flutuante:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }
  @keyframes zap-pulso {
    0%, 78%, 100% { box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25); }
    86% { box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25), 0 0 0 14px rgba(37, 211, 102, 0.18); }
    94% { box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25), 0 0 0 22px rgba(37, 211, 102, 0); }
  }
  .zap-flutuante { animation: zap-pulso 5s ease-in-out infinite; }
  @media (max-width: 600px) {
    .zap-flutuante { right: 16px; bottom: 16px; width: 54px; height: 54px; }
  }
</style>
