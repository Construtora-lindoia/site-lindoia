# Variáveis de ambiente — configurar na Netlify (Site settings > Environment variables).
# Copie pra .env pra rodar local com `netlify dev`.

# Banco de dados (Neon) — obrigatório pro funil de leads e o analytics
DATABASE_URL=

# OAuth do GitHub (login do painel /admin) — criar um OAuth App no GitHub do cliente.
# Callback do OAuth App = https://SEU-SITE/api/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Repositório do site (dono/nome) — usado pra autorizar quem edita pelo painel
GITHUB_REPO=Construtora-lindoia/site-lindoia

# URL pública do site (pros links dos e-mails de aviso de lead)
SITE_URL=https://construtoralindoia.com.br

# (Opcional) Aviso de novo lead por e-mail via Resend — ativar quando tiver domínio verificado
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=Painel Lindóia <onboarding@resend.dev>
